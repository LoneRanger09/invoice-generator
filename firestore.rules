rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if user owns the document by doc ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Check if user owns document by createdBy or userId field
    function isDataOwner() {
      return isAuthenticated() && (
        (resource != null && (resource.data.userId == request.auth.uid || resource.data.createdBy == request.auth.uid)) ||
        (request.resource != null && (request.resource.data.userId == request.auth.uid || request.resource.data.createdBy == request.auth.uid))
      );
    }

    // User Profile collection (doc ID = user UID)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Shop Details collection (doc ID = user UID)
    match /shopDetails/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      allow read, update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.createdBy == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.createdBy == request.auth.uid
      );
    }

    // Products collection
    match /products/{productId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Customers collection
    match /customers/{customerId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
